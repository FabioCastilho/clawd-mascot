    "PostToolUse":      [{"hooks": [{"type": "command", "command": "python3 CAMINHO/clawd-hook.py PostToolUse"}]}],
    "PostToolUseFailure": [{"hooks": [{"type": "command", "command": "python3 CAMINHO/clawd-hook.py PostToolUseFailure"}]}],
